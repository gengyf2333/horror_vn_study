  Anna:
    characterName: 
    root: {fileID: 0}
  Uru:
    characterName: 
    root: {fileID: 0}
  BKM: {fileID: 1096936866}
  Choices: {fileID: 2090269619}
  Buttons: {fileID: 1523307401}
  A: 1
  s:
  - "\u4FA6\u63A2\u5B89\u5A1C\u548C\u52A9\u624B\u5B89\u5FB7\u68EE\u7ECF\u8425\u7740\u8857\u89D2\u7684\u4E00\u95F4\u5C0F\u4E8B\u52A1\u6240\uFF0C\u4E24\u4EBA\u5E73\u7A33\u7684\u751F\u6D3B\u548C\u8FD9\u5EA7\u5B81\u9759\u7684\u5C0F\u9547\u4E00\u6837\uFF0C\u4EFF\u4F5B\u6BEB\u65E0\u6D9F\u6F2A\u3002:   "
  - "\u76F4\u5230\u4E00\u5C01\u7A81\u7136\u51FA\u73B0\u7684\u9080\u8BF7\u4FE1\uFF0C\u6253\u7834\u4E86\u65E5\u5E38\u7684\u5FAA\u73AF\u3002"
  - "\u6253\u5F00\u53F0\u706F\uFF0C\u660F\u9EC4\u7684\u706F\u5149\u6253\u5728\u4E86\u4E00\u5C01\u964C\u751F\u7684\u4FE1\u4E0A\u3002"
  - "\u5B89\u5A1C\u96BE\u63A9\u75B2\u60EB\u7684\u53CC\u7738\u76EF\u7740\u90A3\u5C01\u4FE1"
  - "\u4FE1\u5C01\u4E0A\u6697\u523B\u7684\u82B1\u7EB9\u5728\u5149\u4E0B\u82E5\u9690\u82E5\u73B0"
  - "=\u8FD9\u4E1C\u897F\u600E\u4E48\u4F1A\u7A81\u7136\u51FA\u73B0\u5728\u5979\u684C\u4E0A\u5462\uFF1F"
  - "\"\u5B89\u5FB7\u68EE\uFF1F\":Anna"
  - "\u5B89\u5A1C\u4E0B\u610F\u8BC6\u5730\u56DB\u5904\u5BFB\u627E\u8D77\u5979\u7684\u52A9\u624B\uFF0C\u4F46\u4E00\u773C\u671B\u5C3D\u7684\u4E8B\u52A1\u6240\u663E\u7136\u6CA1\u4EBA\u5176\u4ED6\u4EBA\u5728\u4E86\u3002: "
  - "\u5B89\u5FB7\u68EE\u6700\u8FD1\u90FD\u6CA1\u6765\u4E8B\u52A1\u6240\u4E86\uFF0C\u6CA1\u4E86\u52A9\u624B\u7684\u534F\u52A9\uFF0C\u5B89\u5A1C\u6BD4\u4EE5\u524D\u8F9B\u82E6\u4E86\u4E0D\u5C11"
  - "\u5979\u64A9\u4E86\u4E00\u628A\u9B13\u8FB9\u6563\u4E71\u7684\u788E\u53D1\uFF0C\u6253\u5F00\u4FE1\u5C01\u3002: "
  - "\"\u4EB2\u7231\u7684\u5B89\u5A1C\uFF1A\u660E\u665A\u5728\u7537\u7235\u5E84\u56ED\u5C06\u4E3E\u884C\u6625\u5B63\u821E\u4F1A\uFF0C\u672C\u5730\u5E74\u8F7B\u7684\u8D35\u65CF\u5C0F\u59D0\u3001\u8D35\u65CF\u516C\u5B50\u4EEC\u501F\u65F6\u5747\u4F1A\u5230\u573A...\":Anna"
  - "\u60A8\u8FD9\u6837\u7F8E\u4E3D\u7684\u5973\u5B50\u4E5F\u4E0D\u5E94\u5F53\u7F3A\u5E2D\u3002\u5C3C\u79D1\u5C14\xB7\u67E5\u7406\u7537\u7235\u8BDA\u9080\u60A8\u4E00\u540C\u524D\u5F80\u53C2\u52A0\u6B22\u5BB4\u3002\u827E\u7433\""
  - "\u6625\u5B63\u821E\u4F1A\uFF1F\u7537\u7235\u5E84\u56ED\uFF1F\u8FD9\u662F\u4EC0\u4E48\u6076\u4F5C\u5267\u5417\uFF1F\""
  - "\u5C3D\u7BA1\u5FC3\u4E2D\u6EE1\u662F\u7591\u60D1\uFF0C\u4F46\u5B89\u5A1C\u8FD8\u662F\u5C06\u9080\u8BF7\u51FD\u6536\u5165\u5305\u4E2D\uFF0C\u4FA6\u63A2\u7684\u76F4\u89C9\u544A\u8BC9\u5979\u4E0D\u8BE5\u8F7B\u89C6\u4EFB\u4F55\u5947\u602A\u7684\u7EBF\u7D22\uFF0C\u4E5F\u8BB8\u8FD9\u5C01\u5947\u602A\u7684\u4FE1\u4EF6\u6B63\u662F\u59D4\u6258\u4EBA\u7684\u8BF7\u6C42\u3002: "
